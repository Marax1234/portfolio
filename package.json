{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "check": "pnpm typecheck && pnpm lint",
    "payload": "PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
    "migrate": "PAYLOAD_CONFIG_PATH=src/payload.config.ts payload migrate",
    "migrate:status": "PAYLOAD_CONFIG_PATH=src/payload.config.ts payload migrate:status",
    "generate:types": "PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:types",
    "generate:importmap": "PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:importmap",
    "seed": "PAYLOAD_CONFIG_PATH=src/payload.config.ts payload run src/seed/index.ts",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait && scripts/storage-init.sh",
    "db:down": "docker compose -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "graphql": "^17.0.2",
    "hls.js": "^1.7.3",
    "motion": "^12.41.0",
    "next": "16.3.6",
    "nodemailer": "^9.1.1",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
